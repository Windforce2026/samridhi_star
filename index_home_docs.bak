-4 my-3"> <a class="rounded-3 shadow1" href="support-services"> <img src="images/placeholder_1.jpg" data-src="images/cath-lab.jpg" data-srcset="images/cath-lab.jpg" alt="Cath Lab" title="Advanced Cath Lab at Samridhi Hospital" class="max lazy rounded-2"> </a> </div>   </div> <hr class="op1"> </div> </section> <section class="py-4 py-lg-5"> <div class="container"> <div class="text-center"> <!-- <h3 class="h2 fw-600 mb-3">Comprehensive Health Care with Healing Philosophy</h3> <p class="mb-4">Samridhi Hospital is recognized as the leader in providing exceptional healthcare services in Siliguri. We are a multispeciality hospital of Siliguri committed to providing the highest standards of medical care by understanding and fulfilling our patients' needs.</p> --> <h1 class="h2 fw-600 mb-3">Welcome to Samridhi Hospital - Pioneering Exceptional Healthcare in Siliguri</h1> <p>Samridhi Hospital is recognized as the leading in providing exceptional healthcare services in Siliguri. As a leading hospital in this region, we are dedicated to providing the highest standards of medical care by understanding and fulfilling our patients' needs.</p> </div> <h4 class="h5 bg-white shadow1 border2 p-3 rounded-5 fw-bold color3 text-center text-uppercase ls2">Centre of Excellence</h4> <div class="row"> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center "> <a href="department/obstetrics-and-gynaecology" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705650399Hgynecology.svg" data-srcset="images/1705650399Hgynecology.svg" alt="Obstetrics and Gynaecology" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/obstetrics-and-gynaecology"> Obstetrics and Gynaecology </a> </div> </div> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center even"> <a href="department/cardiology-and-cardiac-surgery" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705651196Hcardiology.svg" data-srcset="images/1705651196Hcardiology.svg" alt="Cardiology and Cardiac Surgery" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/cardiology-and-cardiac-surgery"> Cardiology and Cardiac Surgery </a> </div> </div> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center "> <a href="department/advanced-laparoscopy-general-and-cancer-surgery" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705651367Hlaparoscopy-surgery.svg" data-srcset="images/1705651367Hlaparoscopy-surgery.svg" alt="Advanced Laparoscopy, General &amp; Cancer Surgery" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/advanced-laparoscopy-general-and-cancer-surgery"> Advanced Lap., Gen. &amp; Cancer Surgery </a> </div> </div> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center even"> <a href="department/gastroenterology" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705651695HGastroenterology.svg" data-srcset="images/1705651695HGastroenterology.svg" alt="Gastroenterology" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/gastroenterology"> Gastroenterology </a> </div> </div> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center "> <a href="department/neurology-and-neurosurgery" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705651856Hneurosurgery.svg" data-srcset="images/1705651856Hneurosurgery.svg" alt="Neurology and Neurosurgery" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/neurology-and-neurosurgery"> Neurology and Neurosurgery </a> </div> </div> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center even"> <a href="department/urology-andrology-and-uro-oncology" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705652107HUrology.svg" data-srcset="images/1705652107HUrology.svg" alt="Urology, Andrology and Uro Oncology" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/urology-andrology-and-uro-oncology"> Urology, Andrology and Uro Oncology </a> </div> </div> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center "> <a href="department/paediatrics-and-neonatology" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705652230Hpediatric.svg" data-srcset="images/1705652230Hpediatric.svg" alt="Paediatrics and Neonatology" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/paediatrics-and-neonatology"> Paediatrics and Neonatology </a> </div> </div> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center even"> <a href="department/dermatology" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705652583HDermatology.svg" data-srcset="images/1705652583HDermatology.svg" alt="Dermatology" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/dermatology"> Dermatology </a> </div> </div> <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center "> <a href="department/plastic-and-reconstructive-surgery" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705656061HReconstructive-Surgery.svg" data-srcset="images/1705656061HReconstructive-Surgery.svg" alt="Plastic &amp; Reconstructive Surgery" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/plastic-and-reconstructive-surgery"> Plastic Surgery </a> </div> </div>  <div class="col-6 col-sm-6 col-md-4 col-lg-4 col-xl-2 my-3"> <div class="height100 bg-white shadow1 prelative transition border2 rounded-5 treeto p-2 p-lg-3 transition text-center "> <a href="department/pulmonology" class="d-block text-center mb-2"> <div class="iconer border1"> <img src="images/placeholder.jpg" data-src="images/1705658676HPulmonology.svg" data-srcset="images/1705658676HPulmonology.svg" alt="Pulmonology" class="max lazy transition" width="60" height="60"> </div> </a> <a class="transition d-block fw-500 font15 lh-22 font16-sm" href="department/pulmonology"> Pulmonology </a> </div> </div>  </div> <div class="text-center mt-3 mt-lg-4"> <a href="departments" class="d-inline-block btn btn3 outline btn-sm">Find All Departments</a> </div> </div> </section> <section class="prelative py-4 py-lg-5 coolbg"> <div class="container"> <div class="row"> <div class="col-12 col-md-4 col-lg-4 my-3"> <div class="text-center d-flex height100 flex-column justify-content-center"> <img src="images/placeholder-f.jpg" data-src="images/facilities.jpg" data-srcset="images/facilities.jpg" alt="Faclities" class="max lazy rounded-5 objectfit"> </div> </div> <div class="col-12 col-md-8 col-lg-8 my-3 text-center"> <h3 class="mb-1 h2 fw-600 mb-3 text-center">Empowering Health with Personalised Treatment</h3> <hr class="op1 my-2"> <h4 class="h5 text-center text-uppercase ls4">Our Diverse Facilities</h4> <hr class="op1 my-2"> <div> <ul class="beshakal fw-500"> <li> <img src="images/icon-ph.jpg" data-src="images/opd.png" data-srcset="images/opd.png" alt="OPD" class="max lazy" width="38" height="38"> <span>Out-Patient Service</span> </li> <li> <img src="images/icon-ph.jpg" data-src="images/ipd.png" data-srcset="images/ipd.png" alt="IPD" class="max lazy" width="38" height="38"> <span>In-Patient Service</span> </li> <li> <img src="images/icon-ph.jpg" data-src="images/laboratory.png" data-srcset="images/laboratory.png" alt="Laboratory" class="max lazy" width="38" height="38"> <span>Laboratory</span> </li> <li> <img src="images/icon-ph.jpg" data-src="images/pathology.png" data-srcset="images/pathology.png" alt="Pathology" class="max lazy" width="38" height="38"> <span>Pathology</span> </li> <li> <img src="images/icon-ph.jpg" data-src="images/icu.png" data-srcset="images/icu.png" alt="Intensive Care Unit" class="max lazy" width="38" height="38"> <span>Intensive Care Unit</span> </li> <li> <img src="images/icon-ph.jpg" data-src="images/ccu.png" data-srcset="images/ccu.png" alt="Critical Care Unit" class="max lazy" width="38" height="38"> <span>Critical Care Unit</span> </li> <li> <img src="images/icon-ph.jpg" data-src="images/ot.png" data-srcset="images/ot.png" alt="Operation Theatre" class="max lazy" width="38" height="38"> <span>Advanced Operation Theatre</span> </li> <li> <img src="images/icon-ph.jpg" data-src="images/diagnostic.png" data-srcset="images/diagnostic.png" alt="Diagnostic" class="max lazy" width="38" height="38"> <span>Precise Diagnostic</span> </li> <li> <img src="images/icon-ph.jpg" data-src="images/emergency.png" data-srcset="images/emergency.png" alt="Emergency" class="max lazy" width="38" height="38"> <span>24x7 Emergency Services</span> </li> </ul> </div> <a href="facilities" class="mt-3 btn btn3 outline font15 btn-md">Find All Facilities</a> </div> </div> <div class="text-center"> <a href="appointment"><img src="images/advt.jpg" alt="Make An Appointment" class="max mt-4 mt-lg-5 rounded-3 border2"></a> </div> </div> </section> <section class="py-5 py-lg-5 ofhidden prelative bglight"> <div class="container"> <h3 class="h2 fw-600 mb-1">Meet Our Team of Doctors</h3> <div class="doctorsteam owl-carousel navcenter my-3"> <div class="item prelative bg-white"> <div class="docblock rounded-5 ofhidden border2 bg-whitee coolbg shadow-sm height100 prelative"> <a href="doctor/dr-prabha-anand" class="d-block p-3 pb-0 text-center rounded-3 bg-white"> <img src="images/placeholder_2.jpg" data-src="images/1706076846Dr.-Prabha-Anand.jpg" data-srcset="images/1706076846Dr.-Prabha-Anand.jpg" alt="Dr. Prabha Anand" class="max mb-2 rounded-3 lazy" width="230" height="256"> </a> <hr class="op1 mt-0"> <div class="text-center px-3"> <h4 class="font18 fw-600 mb-1"><a href="doctor/dr-prabha-anand" class="d-block th-color">Dr. Prabha Anand</a></h4> <p class="lh-22 font14 m-0 fw-500 color333">MBBS, MD (Microbiology)</p> </div> <div class="sanko"> <div class="full px-3 pb-2 d-flex align-items-center justify-content-center"> <a href="doctor/dr-prabha-anand" class="btn btn-sm btn3 lh-20 font14 outline">Know More <i class="bi 